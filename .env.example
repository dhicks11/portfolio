# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient email for contact form notifications
CONTACT_EMAIL=hicksdigital.dev@gmail.com

# Upstash Redis for rate limiting (optional — falls back to in-memory)
# Get from https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Sentry error monitoring (optional)
# Get from https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
